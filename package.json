{
  "name": "signage-device-client",
  "version": "1.0.0",
  "description": "Signage device client - Electron kiosk player",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "id.biz.votm.signage.player",
    "productName": "Aurea Signage Player",
    "files": [
      "electron/**/*",
      "index.html",
      "config.example.json",
      "package.json"
    ],
    "extraResources": [
      { "from": "config.json", "to": "config.json" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    }
  }
}